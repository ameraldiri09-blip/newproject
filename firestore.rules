rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['ameraldiri09@gmail.com']; }

    match /trips/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // الزبون يستطيع فقط إضافة مقاعد إلى قائمة المقاعد المحجوزة
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taken'])
        && request.resource.data.taken.hasAll(resource.data.taken)
        && request.resource.data.taken.size() <= 50;
    }
    match /bookings/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING_VERIFICATION';
      allow update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
